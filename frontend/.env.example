# =========================================================
# ZESTRO Frontend Environment Variables (.env.example)
# =========================================================

# Production API Base URL (Leave empty to default to same-origin /api or provide deployed backend URL)
# Example for Render backend: https://zestro-backend.onrender.com/api
VITE_API_URL=

# Backend Port (Used for local LAN testing)
VITE_BACKEND_PORT=5001

# Google OAuth 2.0 Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Client JWT Session Secret
VITE_JWT_SECRET=your_client_jwt_secret
