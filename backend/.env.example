PORT=5001
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Email Service Configuration (Nodemailer / SMTP Provider)
# Use your verified sender credentials (e.g., Gmail App Password, Resend, or Brevo SMTP)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_verified_sender_email@gmail.com
EMAIL_PASS=your_smtp_app_password
EMAIL_FROM_NAME=ZESTRO

# Twilio WhatsApp Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890
